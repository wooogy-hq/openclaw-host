# ---- Identity / S3 (shared with the serverless deployment) ----
# The S3 bucket and userId MUST match the serverless side to share state.
DATA_BUCKET=
USER_ID=
AWS_REGION=ap-northeast-2
# Standard AWS credential chain is used (env vars, ~/.aws/credentials, or instance role).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Long-lived hosts with an already-populated bind mount can skip replaying all
# historical S3 objects at startup.
RESTORE_ON_START=true
# Mirror workspace/sessions to S3 on the periodic tick and at shutdown. Set to
# false for a purely machine-local host: no PUT/LIST requests, no S3 cost — and
# no off-machine copy, so the local disk becomes the only copy of your state.
BACKUP_ENABLED=true

# ---- AI provider (provider- & model-agnostic; mirrors serverless provider-config) ----
# Named providers: anthropic | bedrock | deepseek | openai. Any other value is a
# CUSTOM OpenAI/Anthropic-compatible backend (requires AI_BASE_URL + AI_MODEL).
AI_PROVIDER=anthropic
AI_MODEL=                        # optional; free-form model id override (model-agnostic)
AI_AUTH=                         # key | oauth | aws-sdk (default per provider; openai defaults to oauth)
AI_THINKING=                     # off|minimal|low|medium|high|xhigh|adaptive|max|ultra
# true = runtime /config agent defaults survive restarts; AI_MODEL/AI_THINKING
# become bootstrap/recovery values until dynamic mode is disabled.
DYNAMIC_AGENT_DEFAULTS=false
ANTHROPIC_API_KEY=               # required for anthropic/deepseek (api-key mode)
# ANTHROPIC_BASE_URL=            # set automatically for deepseek
#
# openai (GPT via ChatGPT/Codex subscription — DEFAULT auth is OAuth):
#   AI_PROVIDER=openai
#   AI_MODEL=gpt-5.5             # or gpt-5-codex, etc.
#   AI_AUTH=oauth               # (default) uses an OpenClaw OpenAI OAuth profile in /state
#   One-time setup (run against the persistent state volume):
#     openclaw models auth login --provider openai --device-code
#   For API-key mode instead:  AI_AUTH=key  +  OPENAI_API_KEY=...
#
# custom OpenAI/Anthropic-compatible backend (e.g. litellm, a local gateway):
#   AI_PROVIDER=litellm  AI_BASE_URL=http://host:port/v1  AI_MODEL=<id>
#   AI_OPENCLAW_API=openai-completions   # or anthropic-messages
#   AI_API_KEY=<key>            # referenced via ${AI_API_KEY}; never written into openclaw.json

# ---- Native OpenClaw channels (OpenClaw connects to these directly) ----
# v1 channel: Telegram (required). Token delivered via env — never written to openclaw.json.
TELEGRAM_BOT_TOKEN=
# DM access policy: pairing (default) | allowlist | open | disabled
TELEGRAM_DM_POLICY=pairing
# Comma-separated numeric Telegram user IDs. REQUIRED when TELEGRAM_DM_POLICY=allowlist.
# TELEGRAM_ALLOW_FROM=123456789,987654321

# ---- Runtime ----
OPENCLAW_GATEWAY_PORT=18789
# Gateway auth token (gateway.auth.token) — REQUIRED. The agent runtime, the Telegram
# ingress, and `openclaw cron` all authenticate to the gateway websocket with this.
# Without it they fail with "requires credentials". Generate one: `openssl rand -hex 32`.
OPENCLAW_GATEWAY_TOKEN=
WORKSPACE_DIR=./data/workspace
OPENCLAW_STATE_DIR=./.openclaw
BACKUP_INTERVAL_MS=120000

# ---- Discord (optional second channel) ----
# Set to enable; leave unset and no discord channel is emitted at all.
# Requires the version-matched plugin:
#   openclaw plugins install @openclaw/discord@<runtime minor>
# Route it to its own agent so it stays separate from the Telegram agent:
#   openclaw agents add work --workspace /data/workspace-work --bind discord
# DISCORD_BOT_TOKEN=
# allowlist (default) | pairing | open
# DISCORD_DM_POLICY=allowlist
# Comma-separated Discord user IDs. REQUIRED when DISCORD_DM_POLICY=allowlist.
# DISCORD_ALLOW_FROM=123456789012345678
# Answer every message in a channel instead of waiting to be @mentioned. Anyone
# in the channel can use the bot either way; this decides whether it listens
# ambiently. One agent turn per message posted — watch the model quota.
# DISCORD_REQUIRE_MENTION=true
# Guild the mention rule applies to. Leave unset and it applies to every guild —
# fine while requireMention is true, careless once it is false.
# DISCORD_GUILD=123456789012345678

# ---- HTTP sidecars (oc-net) — see docker-compose.sidecars.yml ----
# SearXNG backend for the built-in web_search tool. Without it web_search fails
# "SearXNG base URL is not configured".
SEARXNG_BASE_URL=http://searxng:8080
# Containerized browser (web automation + live viewer); the agent drives it over HTTP.
BROWSER_URL=http://containerized-browser:8080
# Shared secret guarding the browser (viewer + /exec). Generate: `openssl rand -hex 24`.
BROWSER_PASSWORD=

# ---- Host paths (read by BOTH run.sh and docker compose) ----
# Where state lives on this machine. The two tools must agree, or switching
# between them forks your agent's history. Defaults are under $HOME.
# HOST_WORKSPACE=/srv/openclaw/workspace
# HOST_STATE=/srv/openclaw/state
# HOST_SKILLS=/srv/openclaw/skills
# Second agent's workspace. /data is root-owned in the image, so an agent whose
# workspace is not bind-mounted cannot write and dies with the container.
# HOST_WORKSPACE_WORK=/srv/openclaw/workspace-work
# Read-only kubectl to bind-mount in, so the agent can get/describe/logs to
# self-verify a deploy but not mutate. Scope its token to a view-only role.
# HOST_KUBECTL=/usr/local/bin/kubectl
# Container uid:gid. Defaults to the invoking user, which must own the paths above.
# HOST_UID=1000
# HOST_GID=1000
