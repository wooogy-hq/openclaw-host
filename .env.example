# ---- Identity / S3 (shared with the serverless deployment) ----
# The S3 bucket and userId MUST match the serverless side to share state.
DATA_BUCKET=
USER_ID=
AWS_REGION=ap-northeast-2
# Standard AWS credential chain is used (env vars, ~/.aws/credentials, or instance role).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---- AI provider (mirrors serverless provider-config) ----
AI_PROVIDER=anthropic            # anthropic | bedrock | deepseek
AI_MODEL=                        # optional override
ANTHROPIC_API_KEY=               # required for anthropic/deepseek
# ANTHROPIC_BASE_URL=            # set automatically for deepseek

# ---- Native OpenClaw channels (OpenClaw connects to these directly) ----
# v1 default: Telegram. Add Slack/Discord/etc. as OpenClaw supports them.
TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_CHAT_IDS=

# ---- Runtime ----
OPENCLAW_GATEWAY_PORT=18789
WORKSPACE_DIR=./data/workspace
OPENCLAW_HOME=./.openclaw
BACKUP_INTERVAL_MS=120000
