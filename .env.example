# openclaw-host configuration. Copy to .env and fill in the first block.
#
# Three kinds of setting live here:
#   1. REQUIRED      the host refuses to start without these
#   2. COMMON        you will probably touch these
#   3. PASSED THROUGH  the host never reads them; docker hands them to OpenClaw
#
# Secrets stay in this file and in the process environment. The host never
# writes one into openclaw.json.

# ── 1. REQUIRED ──────────────────────────────────────────────────────────────

# Identifies you in the S3 layout and in OpenClaw's state. Any stable string.
USER_ID=

# At least one channel token, or the gateway has no way in.
TELEGRAM_BOT_TOKEN=
# DISCORD_BOT_TOKEN=

# Which model answers. anthropic | bedrock | deepseek | openai, or any other
# value for a custom OpenAI/Anthropic-compatible endpoint (then AI_BASE_URL and
# AI_MODEL are required too).
AI_PROVIDER=anthropic
# How it authenticates: key | oauth | aws-sdk.
# openai + oauth runs turns on a ChatGPT subscription instead of API billing:
#   openclaw models auth login --provider openai --device-code
AI_AUTH=key

# ── 2. COMMON ────────────────────────────────────────────────────────────────

# S3 state sync. Leave BACKUP_ENABLED=false and RESTORE_ON_START=false for a
# machine-local host: no PUT/LIST requests, no bucket needed, and no copy of
# your state anywhere but this disk.
BACKUP_ENABLED=false
RESTORE_ON_START=false
# DATA_BUCKET=                   # required once either of the two above is true
# AWS_REGION=ap-northeast-2

# Where state lives on this machine. run.sh and docker-compose.yml both read
# these, so they cannot disagree. Defaults are under $HOME.
# HOST_WORKSPACE=/srv/openclaw/workspace
# HOST_STATE=/srv/openclaw/state
# HOST_SKILLS=/srv/openclaw/skills

# Lets the agent push to GitHub. Written to /state/.gh-token at boot, which a
# credential helper reads; see "Agents & channels" in the README for how a
# second agent gets its own token instead of sharing this one.
# GITHUB_TOKEN=

# Authenticates the agent and `openclaw cron` to the gateway websocket.
# Generate: openssl rand -hex 32
# OPENCLAW_GATEWAY_TOKEN=

# Who may DM the bot. pairing | allowlist | open | disabled.
# allowlist with no ids blocks everyone and is rejected at startup.
# TELEGRAM_DM_POLICY=pairing
# TELEGRAM_ALLOW_FROM=123456789
# DISCORD_DM_POLICY=allowlist
# DISCORD_ALLOW_FROM=123456789012345678
# Guild the mention rule applies to. Unset means every guild, which is fine
# while requireMention is true and careless once it is false.
# DISCORD_GUILD=123456789012345678
# DISCORD_REQUIRE_MENTION=true

# ── 3. PASSED THROUGH TO OPENCLAW ────────────────────────────────────────────
# The host never reads these. Docker hands them to the gateway, which does.

# Provider key for AI_AUTH=key. Name it whatever your provider expects.
# ANTHROPIC_API_KEY=
# AI_API_KEY=
# Custom endpoint, required when AI_PROVIDER is not one of the named four.
# AI_BASE_URL=
# AI_MODEL=
# AI_OPENCLAW_API=openai-completions

# Standard AWS credential chain also works: ~/.aws/credentials, instance role.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Sidecars from docker-compose.sidecars.yml. Without SearXNG the built-in
# web_search tool fails with "SearXNG base URL is not configured".
# SEARXNG_BASE_URL=http://searxng:8080
# BROWSER_URL=http://containerized-browser:8080
# BROWSER_PASSWORD=              # openssl rand -hex 24

# ── 4. ADVANCED ──────────────────────────────────────────────────────────────

# Image build args, forwarded by run.sh. Read docs/versions.md before bumping
# OPENCLAW_VERSION: 2026.9.x also needs a newer Node base image.
# OPENCLAW_VERSION=2026.7.1-2
# AGENT_SKILLS_REF=0.6.9
# WITH_GITOPS_TOOLS=1            # helm, kubeconform, conftest in the image

# A second agent's workspace. /data is root-owned in the image, so an agent
# without a bind mount here cannot write and dies with the container.
# HOST_WORKSPACE_WORK=/srv/openclaw/workspace-work
# Read-only kubectl for the agent to verify its own deploys.
# HOST_KUBECTL=/usr/local/bin/kubectl
# Container uid:gid. Defaults to the invoking user, who must own the paths above.
# HOST_UID=1000
# HOST_GID=1000

# Thinking effort: off|minimal|low|medium|high|xhigh|adaptive|max|ultra
# AI_THINKING=high
# Keep model and thinking choices made at runtime across reboots.
# DYNAMIC_AGENT_DEFAULTS=false
# BACKUP_INTERVAL_MS=120000
# OPENCLAW_BIN=openclaw
# OPENCLAW_GATEWAY_PORT=18789
