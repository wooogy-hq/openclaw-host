#!/bin/sh
# Per-AGENT git credential helper.
#
# OpenClaw has no per-agent env injection, but each agent owns a workspace tree
# and git runs this helper with cwd inside the repo it is acting on — so the
# working directory identifies the agent:
#
#   /data/workspace/*       -> main (따까리)      -> wooogy-hq token
#   /data/workspace-work/*  -> work, ga-analysis  -> saedungji token
#   anything else           -> wooogy-hq token
#
# The point is the direction: the saedungji token is reachable ONLY from the work
# tree. main cannot obtain it whatever repo path it asks for, which is what a
# path-based router (the previous design) could not guarantee.
#
# Requires credential.https://github.com.helper to point here.
[ "$1" = "get" ] || exit 0

# Drain git's request on stdin. We route on cwd, not on the path it sends.
while IFS= read -r line; do [ -z "$line" ] && break; done

case "$PWD/" in
  /data/workspace-work/*) tok=$(cat /state/.gh-token-saju 2>/dev/null) ;;
  *)                      tok=$(cat /state/.gh-token 2>/dev/null) ;;
esac

echo "username=x-access-token"
echo "password=$tok"
