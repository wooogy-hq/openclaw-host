{
  "name": "openclaw-host",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Standalone, machine-resident OpenClaw runtime with S3 state sync. Runs OpenClaw with its native channels as an always-on service and mirrors workspace/session state to the same S3 bucket the serverless deployment uses.",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist/index.js",
  "bin": {
    "openclaw-host": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "openclaw": "^2026.4.26",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
